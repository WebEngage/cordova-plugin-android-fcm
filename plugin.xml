<?xml version='1.0' encoding='utf-8'?>
<plugin id="we-cordova-android-fcm" version="2.0.0"
    xmlns="http://apache.org/cordova/ns/plugins/1.0" 
    xmlns:android="http://schemas.android.com/apk/res/android">
    <name>AndroidFcmPlugin</name>

    <engines>
        <engine name="cordova-android" version=">=12.0.0" />
    </engines>

    <!-- WebEngage classes are imported directly by the Java sources, so the base
         WebEngage Cordova plugin is a hard compile-time dependency. -->
    <dependency id="cordova-plugin-webengage" version=">=2.0.0" />

    <js-module name="AndroidFcmPlugin" src="www/AndroidFcmPlugin.js">
        <clobbers target="androidfcm" />
    </js-module>
    <platform name="android">
        <!-- Turns on cordova-android's Google Services Gradle plugin support so that
             google-services.json is processed with no change in the app's config.xml.
             The app's own config.xml is merged on top: an app that sets this to "false"
             must apply the Google Services Gradle plugin itself (see README). -->
        <config-file parent="/*" target="config.xml">
            <preference name="GradlePluginGoogleServicesEnabled" value="true" />
        </config-file>
        <config-file parent="/*" target="res/xml/config.xml">
            <feature name="AndroidFcmPlugin">
                <param name="android-package" value="com.androidfcm.cordova.AndroidFcmPlugin" />
            </feature>
        </config-file>
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.INTERNET" />
        </config-file>
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <meta-data
            android:name="com.webengage.child.cordova_fcm"
            android:value="cordova_fcm:${we_cordova_fcm_version}" />
            <service android:name="com.androidfcm.cordova.CustomFirebaseMessagingService" android:exported="false" >
                <intent-filter>
                    <action android:name="com.google.firebase.MESSAGING_EVENT" />
                </intent-filter>
            </service>
        </config-file>

        <source-file src="src/android/AndroidFcmPlugin.java" target-dir="src/com/androidfcm/cordova/" />
        <source-file src="src/android/CustomFirebaseMessagingService.java" target-dir="src/com/androidfcm/cordova/" />

        <framework src="src/android/AndroidFcmPlugin.gradle" custom="true" type="gradleReference"/>
        <resource-file src="src/android/cordova_fcm_version.properties" target="cordova_fcm_version.properties" />

        <hook src="hooks/android_after_prepare.js" type="after_prepare" />
    </platform>
</plugin>
